#DATABASE
DATABASE_URL=postgresql+asyncpg://username:password@db:5432/name_db
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=name_db

#JWT
#openssl rand -hex 32
JWT_SECRET_KEY=secret_key

REDIS_PASSWORD=redis
REDIS_USER=redis
REDIS_USER_PASSWORD=redis


#FIRST ADMIN BOOTSTRAP (one-time command)
FIRST_ADMIN_EMAIL=admin@mail.com
FIRST_ADMIN_PASSWORD=change_me
FIRST_ADMIN_NAME=Admin
FIRST_ADMIN_SURNAME=User
FIRST_ADMIN_PATRONYMIC=

#logging
#"dev" - разработка, "prod" - продакшен
ENV_TYPE=type

TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/messenger_test
POSTGRES_TEST_DB=messenger_test